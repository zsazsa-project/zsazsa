# What zsazsa needs. A lower bound is the oldest version zsazsa works with.
#
# requirements.txt pins every package, these and the ones they pull in, to the
# version that is installed. It is generated from this file, not edited:
#
#   uv pip compile requirements.in --universal --python-version 3.11 -o requirements.txt
#
# --universal because zsazsa runs on Python 3.11 and later, and some packages
# need another version, or an extra package, on the older ones. The lock marks
# those pins with the Python versions they are for. Without --upgrade, uv keeps
# the versions already pinned and only resolves what changed here.
pymisp>=2.5,<3          # 2.5.34.2 stopped parsing the galaxy clusters MISP
                        # serves, worked around in core/pymisp_compat.py
openai>=1.0,<3
requests>=2.32,<3
flask>=3.1,<4
werkzeug>=3.1,<4        # routing and datastructures used directly
markupsafe>=2.1,<4      # escaping used directly
urllib3>=2.0,<3
curl_cffi>=0.17.0,<1
markdownify>=0.12,<2
markdown-it-py>=3.0,<5
weasyprint>=70          # below 70 is CVE-2026-55073, an SSRF in the
                        # renderer that reaches every product PDF
pillow>=10.0,<14        # used directly by the Diamond Model renderer
beautifulsoup4>=4.12,<5
